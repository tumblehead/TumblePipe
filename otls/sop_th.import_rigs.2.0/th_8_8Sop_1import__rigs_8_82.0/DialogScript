# Dialog script for th::import_rigs::2.0 automatically generated

{
    name	th::import_rigs::2.0
    script	th::import_rigs::1.0
    label	"th import rigs"

    help {
	""
    }

    inputlabel	1	"Sub-Network Input #1"
    inputlabel	2	"Sub-Network Input #2"
    inputlabel	3	"Sub-Network Input #3"
    inputlabel	4	"Sub-Network Input #4"

    groupsimple {
        name    "discovery"
        label   "Discovery"

        parm {
            name    "stage_path"
            label   "Stage"
            type    oppath
            default { "" }
            help    "LOP node whose stage Discover reads. Empty: the stage fed into the th::animate this node sits in."
            parmtag { "opfilter" "!!LOP!!" }
            parmtag { "oprelative" "." }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "discover"
            label   "Discover"
            type    button
            default { "0" }
            help    "Replace the rows with one per animatable asset on the stage that has a rig published (Instances = its prims), keeping a row's channel and version, then Import."
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.sops.import_rigs as th_node; th_node.discover(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
    }

    groupsimple {
        name    "selection"
        label   "Selection"

        multiparm {
            name    "rig_imports"
            label    "Rig imports"

            parm {
                name    "entity_select#"
                label   "Entity"
                type    button
                nolabel
                joinnext
                default { "0" }
                parmtag { "button_icon" "hicon:/SVGIcons.index?BUTTONS_tree_full.svg" }
                parmtag { "script_callback" "import tumblepipe.pipe.houdini.sops.import_rigs as th_node; th_node.select(kwargs)" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "entity#"
                label   "Entity"
                type    string
                invisible
                nolabel
                joinnext
                default { "" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "entity_label#"
                label   "entity_label"
                type    label
                nolabel
                joinnext
                default { "" }
            }
            parm {
                name    "channel#"
                label   "Channel"
                type    string
                nolabel
                joinnext
                default { "default" }
                menu {
                    [ "from tumblepipe.pipe.houdini.sops import import_rigs" ]
                    [ "from tumblepipe.pipe.houdini import menus" ]
                    [ "" ]
                    [ "index = int(kwargs['parm'].name()[len('channel'):])" ]
                    [ "node = import_rigs.ImportRigs(hou.pwd())" ]
                    [ "return menus.list_to_menu(node.list_channel_names(index))" ]
                    language python
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "variant#"
                label   "Legacy Variant"
                type    string
                invisible
                default { "default" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "version#"
                label   "Version"
                type    string
                nolabel
                joinnext
                default { "latest" }
                menu {
                    [ "from tumblepipe.pipe.houdini.sops import import_rigs" ]
                    [ "from tumblepipe.pipe.houdini import menus" ]
                    [ "" ]
                    [ "index = int(kwargs['parm'].name()[len('version'):])" ]
                    [ "node = import_rigs.ImportRigs(hou.pwd())" ]
                    [ "return menus.list_to_menu(node.list_version_names(index))" ]
                    language python
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "version_label#"
                label   "version_label#"
                type    label
                nolabel
                joinnext
                default { "" }
            }
            parm {
                name    "instances#"
                label   "Instances"
                type    integer
                nolabel
                default { "1" }
                range   { 1! 10 }
                parmtag { "script_callback_language" "python" }
            }
        }

    }

    groupsimple {
        name    "actions"
        label   "Actions"

        parm {
            name    "import"
            label   "Import"
            type    button
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.sops.import_rigs as th_node; th_node.execute(kwargs)" }
