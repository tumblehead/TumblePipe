# Dialog script for th::import_scene::1.0

{
    name	th::import_scene::1.0
    script	th::import_scene::1.0
    label	"th import scene"

    output	geometry	geometry
    output	camera	camera
    signature	default	Default	{ }	{ Geometry Metadata }

    help {
	"The shot's staged scene as geometry and its render camera, for rasterizing in a comp (wire both into a Rasterize Geometry)."
    }

    groupsimple {
        name    "selection"
        label   "Scene"

        parm {
            name    "entity_select"
            label   "Shot"
            type    button
            invisible
            joinnext
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_scene as th_node; th_node.select_entity(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity_browse"
            label   "Browse..."
            type    button
            joinnext
            default { "0" }
            help    "Open the entity picker to search for and pick the entity this node addresses."
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_scene as th_node; th_node.select_entity(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity"
            label   "Shot"
            type    string
            invisible
            joinnext
            default { "from_context" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity_label"
            label   "entity_label"
            type    label
            nolabel
            default { "from_context: none" }
        }
        parm {
            name    "channel"
            label   "Channel"
            type    string
            default { "default" }
            menu {
                [ "opmenu -l -a lopnet/import_shot channel" ]
            }
        }
        parm {
            name    "department"
            label   "Department"
            type    string
            default { "from_context" }
            menu {
                [ "opmenu -l -a lopnet/import_shot department" ]
            }
        }
        parm {
            name    "version"
            label   "Version"
            type    string
            default { "latest" }
            menu {
                [ "opmenu -l -a lopnet/import_shot version" ]
            }
        }
        parm {
            name    "version_label"
            label   "Reads"
            type    label
            default { "" }
        }
    }

    groupsimple {
        name    "geometry_group"
        label   "Geometry"

        parm {
            name    "primpattern"
            label   "Primitives"
            type    string
            default { "/*" }
            help    "The prims imported as geometry; anything that is not geometry (cameras, lights) adds nothing."
        }
        parm {
            name    "purpose"
            label   "Purpose"
            type    string
            default { "render" }
            menu {
                "render"    "Render"
                "proxy"     "Proxy"
                "guide"     "Guide"
            }
        }
        parm {
            name    "timesample"
            label   "Time Sample"
            type    ordinal
            default { "1" }
            help    "Animated imports the current frame and recooks every frame; Static imports one frame."
            menu {
                "static"    "Static"
                "animated"  "Animated"
            }
        }
        parm {
            name    "staticimportframe"
            label   "Static Frame"
            type    float
            default { "$FSTART" }
            hidewhen "{ timesample == 1 }"
        }
    }

    groupsimple {
        name    "camera_group"
        label   "Camera"

        parm {
            name    "camera_prim"
            label   "Camera"
            type    string
            default { "/cameras/render_camera" }
        }
    }

    groupsimple {
        name    "actions"
        label   "Actions"

        parm {
            name    "execute"
            label   "Import"
            type    button
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_scene as th_node; th_node.execute(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
    }

}
