--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/scene.chn"
Content-Type: text/plain

{
    channel staticimportframe {
      lefttype = extend
      righttype = extend
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../staticimportframe\") }
    }
    channel entity {
      lefttype = extend
      righttype = extend
      defaultString = \"from_context\"
      flags = 0
      segment { options = {	 autoslope  ai ao }

	 length = 0 accel = 0.33333333333333331 0.33333333333333331 expr = chs(\"../entity\") }
    }
    channel channel {
      lefttype = extend
      righttype = extend
      defaultString = \"default\"
      flags = 0
      segment { options = {	 autoslope  ai ao }

	 length = 0 accel = 0.33333333333333331 0.33333333333333331 expr = strreplace(chs(\"../channel\"),\"*\",\"default\") }
    }
    channel department {
      lefttype = extend
      righttype = extend
      defaultString = \"from_context\"
      flags = 0
      segment { options = {	 autoslope  ai ao }

	 length = 0 accel = 0.33333333333333331 0.33333333333333331 expr = chs(\"../scene_department\") }
    }
    channel version {
      lefttype = extend
      righttype = extend
      defaultString = \"latest\"
      flags = 0
      segment { options = {	 autoslope  ai ao }

	 length = 0 accel = 0.33333333333333331 0.33333333333333331 expr = chs(\"../scene_version\") }
    }
    channel camera_prim {
      lefttype = extend
      righttype = extend
      defaultString = \"/cameras/render_camera\"
      flags = 0
      segment { options = {	 autoslope  ai ao }

	 length = 0 accel = 0.33333333333333331 0.33333333333333331 expr = chs(\"../camera_prim\") }
    }
    channel primpattern {
      lefttype = extend
      righttype = extend
      defaultString = \"/*\"
      flags = 0
      segment { options = {	 autoslope  ai ao }

	 length = 0 accel = 0.33333333333333331 0.33333333333333331 expr = chs(\"../primpattern\") }
    }
    channel purpose {
      lefttype = extend
      righttype = extend
      defaultString = \"render\"
      flags = 0
      segment { options = {	 autoslope  ai ao }

	 length = 0 accel = 0.33333333333333331 0.33333333333333331 expr = chs(\"../purpose\") }
    }
    channel timesample {
      lefttype = extend
      righttype = extend
      default = 1
      flags = 0
      segment { options = {	 untie  iv ov is os ia oa }

	 length = 0 expr = ch(\"../timesample\") }
    }
  }

