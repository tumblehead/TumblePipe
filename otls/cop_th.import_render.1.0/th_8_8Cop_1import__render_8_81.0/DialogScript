# Dialog script for th::import_render::1.0

{
    name	th::import_render::1.0
    script	th::import_render::1.0
    label	"th import render"

    output	rgba	rgba
    output	aovs	aovs
    signature	default	Default	{ }	{ RGBA Cable }

    help {
	"A shot's finished render: the beauty (rgba) and a cable of the other AOVs the comp reads (aovs). Channel * reads every channel: rgba is them laid over each other, the cable carries each channel's beauty and AOVs."
    }

    groupsimple {
        name    "selection"
        label   "Render"

        parm {
            name    "entity_select"
            label   "Shot"
            type    button
            joinnext
            default { "0" }
            parmtag { "button_icon" "hicon:/SVGIcons.index?BUTTONS_tree_full.svg" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.select_entity(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity"
            label   "Shot"
            type    string
            invisible
            joinnext
            default { "from_context" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity_label"
            label   "entity_label"
            type    label
            nolabel
            default { "from_context: none" }
        }
        parm {
            name    "channel"
            label   "Channel"
            type    string
            default { "default" }
            help    "The channel to read; All channels (*) reads every channel of the shot in this one node."
            menu {
                [ "from tumblepipe.pipe.houdini.cops import import_render" ]
                [ "" ]
                [ "return import_render.ImportRender(hou.pwd()).channel_menu()" ]
                language python
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "department"
            label   "Department"
            type    string
            default { "best" }
            help    "best: the highest render department below composite with a complete version (denoise, else render)."
            menu {
                [ "from tumblepipe.pipe.houdini.cops import import_render" ]
                [ "from tumblepipe.pipe.houdini import menus" ]
                [ "" ]
                [ "node = import_render.ImportRender(hou.pwd())" ]
                [ "return menus.list_to_menu(node.list_department_names())" ]
                language python
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "version"
            label   "Version"
            type    string
            default { "latest" }
            help    "latest: the newest complete version. Pinning a version needs a concrete department."
            menu {
                [ "from tumblepipe.pipe.houdini.cops import import_render" ]
                [ "from tumblepipe.pipe.houdini import menus" ]
                [ "" ]
                [ "node = import_render.ImportRender(hou.pwd())" ]
                [ "return menus.list_to_menu(node.list_version_names())" ]
                language python
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "version_label"
            label   "Reads"
            type    label
            default { "" }
        }
        parm {
            name    "resolved"
            label   "Resolved"
            type    string
            invisible
            default { "" }
        }
        parm {
            name    "fields"
            label   "Fields"
            type    string
            invisible
            default { "" }
        }
        parm {
            name    "build_key"
            label   "Build Key"
            type    string
            invisible
            default { "" }
        }
        parm {
            name    "pins"
            label   "Pins"
            type    string
            invisible
            default { "" }
            help    "Set by the composite worker: an all-channels import's frozen version per channel."
        }
    }

    groupsimple {
        name    "outputs_group"
        label   "Outputs"

        parm {
            name    "unpack_outputs"
            label   "AOV Outputs"
            type    toggle
            default { "0" }
            help    "Keep a Cable Unpack beside the node with one output per AOV in the cable, kept in step with it."
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.unpack_changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
    }

    groupsimple {
        name    "actions"
        label   "Actions"

        parm {
            name    "execute"
            label   "Update"
            type    button
            joinnext
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.execute(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "open_location"
            label   "Open Location"
            type    button
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.open_location(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
    }

}
