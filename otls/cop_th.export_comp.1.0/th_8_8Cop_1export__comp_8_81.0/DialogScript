# Dialog script for th::export_comp::1.0

{
    name	th::export_comp::1.0
    script	th::export_comp::1.0
    label	"th export comp"

    input	comp	comp
    output	comp	comp
    signature	default	Default	{ RGBA }	{ RGBA }

    help {
	"The end of a comp. Submit renders every export_comp in the workfile as one composite version per shot. Its input passes through, so the node shows what it exports."
    }

    groupsimple {
        name    "selection"
        label   "Output"

        parm {
            name    "entity_select"
            label   "Shot"
            type    button
            invisible
            joinnext
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.export_comp as th_node; th_node.select_entity(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity_browse"
            label   "Browse..."
            type    button
            joinnext
            default { "0" }
            help    "Open the entity picker to search for and pick the entity this node addresses."
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.export_comp as th_node; th_node.select_entity(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity"
            label   "Shot"
            type    string
            invisible
            joinnext
            default { "from_context" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity_label"
            label   "entity_label"
            type    label
            nolabel
            default { "from_context: none" }
        }
        parm {
            name    "layer"
            label   "Layer"
            type    string
            default { "comp" }
            help    "comp: the merged comp, written as the version's cross-channel layer (composite/slapcomp). A channel: a per-channel output."
            menu {
                [ "from tumblepipe.pipe.houdini.cops import export_comp" ]
                [ "from tumblepipe.pipe.houdini import menus" ]
                [ "" ]
                [ "node = export_comp.ExportComp(hou.pwd())" ]
                [ "return menus.list_to_menu(node.list_layer_names())" ]
                language python
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.export_comp as th_node; th_node.refresh(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "warning"
            label   "Warning"
            type    label
            default { "" }
            hidewhen "{ warning == \"\" }"
        }
    }

    groupsimple {
        name    "jobs"
        label   "Jobs"

        parm {
            name    "preview_frames"
            label   "Preview Frames"
            type    toggle
            joinnext
            default { "0" }
            help    "Also render the first, middle and last frames (or the List beside it) as a quick task before the full range."
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.export_comp as th_node; th_node.refresh(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "preview_frame_list"
            label   "List"
            type    string
            default { "" }
            disablewhen "{ preview_frames == 0 }"
            help    "The Preview Frames List: frames to render first as the preview, space separated, in this order (key poses, say). Empty: the first, middle and last frame. A frame outside the comp's frames or off the Step is dropped, with a warning."
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.export_comp as th_node; th_node.refresh(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "frame_range"
            label   "Frame Range"
            type    string
            default { "from_context" }
            menu {
                [ "from tumblepipe.pipe.houdini import frame_range" ]
                [ "from tumblepipe.pipe.houdini.cops import export_comp" ]
                [ "" ]
                [ "return frame_range.menu(export_comp.ExportComp(hou.pwd()), (('from_context', 'From Config'), ('from_settings', 'From Settings')))" ]
                language python
            }
        }
        parm {
            name    "frame_settings"
            label   "Start/End-Frame"
            type    intvector2
            size    2
            default { "1001" "1100" }
            disablewhen "{ frame_range == from_context }"
            range   { 1! 999999! }
        }
        parm {
            name    "roll_settings"
            label   "Pre/Post-Roll"
            type    intvector2
            size    2
            default { "0" "0" }
            disablewhen "{ frame_range == from_context }"
            range   { 0! 999999! }
        }
        parm {
            name    "stepsize"
            label   "Step"
            type    integer
            default { "1" }
            range   { 1! 10 }
        }
        parm {
            name    "batchsize"
            label   "Batch Size"
            type    integer
            default { "5" }
            range   { 1! 50 }
        }
        parm {
            name    "copy_to_edit"
            label   "Copy to Edit"
            type    toggle
            default { "0" }
        }
    }

    groupsimple {
        name    "farm"
        label   "Farm"

        parm {
            name    "pool"
            label   "Pool"
            type    string
            default { "" }
            menu {
                [ "from tumblepipe.pipe.houdini.cops import export_comp" ]
                [ "" ]
                [ "return export_comp.ExportComp(hou.pwd()).pool_menu()" ]
                language python
            }
        }
        parm {
            name    "priority"
            label   "Priority"
            type    integer
            default { "50" }
            range   { 0! 100! }
        }
    }

    parm {
        name    "render_output"
        label   "Render Output"
        type    file
        invisible
        default { "" }
        help    "Set by the composite worker: where the render ROP writes."
    }
    parm {
        name    "render_range"
        label   "Render Range"
        type    intvector2
        size    2
        invisible
        default { "1001" "1001" }
        help    "Set by the composite worker: the frames the render ROP writes."
    }

    groupsimple {
        name    "actions"
        label   "Actions"

        parm {
            name    "submit"
            label   "Submit"
            type    button
            joinnext
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.export_comp as th_node; th_node.submit_kwargs(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "open_location"
            label   "Open Location"
            type    button
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.export_comp as th_node; th_node.open_location(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
    }

}
