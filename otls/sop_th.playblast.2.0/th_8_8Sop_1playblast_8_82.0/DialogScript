# Dialog script for th::playblast::2.0 automatically generated

{
    name	th::playblast::2.0
    script	Tumblehead::th_playblast::1.0
    label	"th playblast"

    help {
	""
    }

    inputlabel	1	"Sub-Network Input #1"
    inputlabel	2	"Sub-Network Input #2"
    inputlabel	3	"Sub-Network Input #3"
    inputlabel	4	"Sub-Network Input #4"

    groupsimple {
        name    "context"
        label   "Context"

        parm {
            name    "entity_select"
            label   "Entity"
            type    button
            joinnext
            default { "0" }
            parmtag { "button_icon" "hicon:/SVGIcons.index?BUTTONS_tree_full.svg" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.sops.playblast as th_node; th_node.select(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity"
            label   "Entity"
            type    string
            invisible
            nolabel
            joinnext
            default { "from_context" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity_label"
            label   "entity_label"
            type    label
            nolabel
            default { "from_context: none" }
        }
        parm {
            name    "department"
            label   "Department"
            type    string
            joinnext
            default { "from_context" }
            menu {
                [ "from tumblepipe.pipe.houdini.sops import playblast" ]
                [ "from tumblepipe.pipe.houdini import menus" ]
                [ "" ]
                [ "node = playblast.Playblast(hou.pwd())" ]
                [ "items = node.list_department_names()" ]
                [ "return menus.list_to_menu(items)" ]
                language python
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "department_label"
            label   "department_label"
            type    label
            nolabel
            default { "" }
        }
        parm {
            name    "camera"
            label   "Camera"
            type    string
            default { "" }
            menu {
                [ "from tumblepipe.pipe.houdini.sops import playblast" ]
                [ "from tumblepipe.pipe.houdini import menus" ]
                [ "" ]
                [ "node = playblast.Playblast(hou.pwd())" ]
                [ "paths = node.list_camera_paths()" ]
                [ "names = [ path.rsplit('/', 1)[-1] for path in paths ]" ]
                [ "return menus.list_to_menu(names)" ]
                language python
            }
            parmtag { "script_callback_language" "python" }
        }
    }

    groupsimple {
        name    "settings"
        label   "Settings"

        parm {
            name    "viewport_lighting"
            label   "Lighting"
            type    string
            default { "scene" }
            help    "What lights the playblast. Scene Lights: the scene's own lights when it has any, else the headlight. Headlight: key, fill and rim lights that follow the camera, always."
            menu {
                "scene"     "Scene Lights"
                "headlight" "Headlight"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "cull"
            label   "Backface Culling"
            type    string
            default { "off" }
            help    "Off: draw both sides of every face (only what the scene itself asks is culled). Back Faces: leave out every mesh's back faces, so a single-sided wall seen from behind is see-through."
            menu {
                "off"       "Off"
                "back"      "Back Faces"
            }
            parmtag { "script_callback_language" "python" }
        }
    }

    groupsimple {
        name    "actions"
        label   "Actions"

        parm {
            name    "playblast"
            label   "Playblast"
            type    button
            joinnext
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.sops.playblast as th_node; th_node.export(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "view_latest"
            label   "View Latest"
            type    button
            joinnext
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.sops.playblast as th_node; th_node.view_latest(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "browse_all"
            label   "Browse All"
            type    button
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.sops.playblast as th_node; th_node.open_location(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "live_playblast"
            label   "Live"
            type    button
            joinnext
            default { "0" }
            help    "Playblast in the background (TumbleView, GPU) to this machine's live folder, the current frame first, for the player's Live take. No version and no daily."
            parmtag { "script_callback" "from tumblepipe.pipe.houdini import live_playblast; live_playblast.start_from_playblast(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "live_playblast_stop"
            label   "Stop Live"
            type    button
            default { "0" }
            help    "Stop this node's live playblast rendering in the background."
            parmtag { "script_callback" "from tumblepipe.pipe.houdini import live_playblast; live_playblast.stop_from_playblast(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
    }

}
