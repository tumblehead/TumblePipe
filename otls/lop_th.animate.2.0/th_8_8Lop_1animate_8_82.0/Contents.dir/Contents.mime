--HOUDINIMIMEBOUNDARY0xD3ADD339-0x00000F49-0x56B122C9-0x00000001HOUDINIMIMEBOUNDARY
Content-Disposition: attachment; filename="hdaroot/zero_transforms.parm"
Content-Type: text/plain

{
version 0.8
python	[ 0	locks=0 ]	(	"from tumblepipe.pipe.houdini import shot_start
from tumblepipe.pipe.houdini.lops import animate_xforms

node = hou.pwd()
# The posed geometry is world space: keep the layout placement on the
# prims that hold more than it, cancel it under them. IN_stage_start is
# the shot stage held at the shot's start: reading IN_stage here would
# make th::animate time dependent whenever the shot stage is.
animate_xforms.zero_transforms(
    node.editableStage(),
    node.node('../IN_stage_start').stage(),
    shot_start.start_frame(node),
)
"	)
maintainstate	[ 0	locks=0 ]	(	"off"	)
}

