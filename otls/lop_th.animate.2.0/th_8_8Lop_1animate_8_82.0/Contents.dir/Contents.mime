{
version 0.8
python	[ 0	locks=0 ]	(	"# The anim_dive ghost: the input stage minus the USD copies of the
# characters whose rigs anim_dive imports (they stand in rest pose).
from tumblepipe.pipe.houdini.lops import animate_ghost

node = hou.pwd()
animate_ghost.prune_rigged_assets(node, node.node('../anim_dive'))
"	)
maintainstate	[ 0	locks=0 ]	(	"off"	)
}

