# Dialog script for th::animate::2.0 automatically generated

{
    name	th::animate::2.0
    script	prism::th_animate::1
    label	"th animate"

    help {
	""
    }

    inputlabel	1	"Input Stage"
    inputlabel	2	"Input 2"
    inputlabel	3	"Input 3"
    inputlabel	4	"Input 4"

    parm {
        name    "ghost_refresh"
        label   "Ghost Refresh"
        type    integer
        invisible
        default { "0" }
        help    "Bumped by th::import_rig(s) after an import, so the dive's ghost sees rigs it was not watching yet."
        range   { 0 10 }
    }
    groupsimple {
        name    "characters_folder"
        label   "Characters"

        parm {
            name    "shapes"
            label   "Shapes"
            type    string
            default { "Base" }
            help    "The character shapes to output (the Scene Invoke Shapes pattern). th::animate's own Scene Invoke outputs these; a Scene Invoke in anim_dive is held to them too: shapes it outputs that this does not pick are left out, with a warning."
        }
        parm {
            name    "discover_characters"
            label   "Discover"
            type    button
            default { "0" }
            help    "Add a row for each character in anim_dive's scene that is not listed yet."
            parmtag { "script_callback" "from tumblepipe.pipe.houdini.lops import animate_invoke; animate_invoke.discover(kwargs['node'])" }
            parmtag { "script_callback_language" "python" }
        }
        multiparm {
            name    "characters"
            label    "Characters"
            default 0

            parm {
                name    "character#"
                label   "Character"
                type    string
                joinnext
                default { "" }
                help    "A character of anim_dive's scene (its name in the scene)."
                menureplace {
                    [ "from tumblepipe.pipe.houdini.lops import animate_invoke" ]
                    [ "return animate_invoke.character_menu(kwargs['node'])" ]
                    language python
                }
            }
            parm {
                name    "geometry#"
                label   "Geometry"
                type    toggle
                joinnext
                default { "1" }
                help    "Output the character's shapes (those matching Shapes)."
            }
            parm {
                name    "skeleton#"
                label   "Skeleton"
                type    toggle
                default { "0" }
                help    "Output the character's posed skeleton (its rig's Base.skel), as curves under /<category>/<character>/skel, for CFX."
            }
        }

    }

    groupsimple {
        name    "live_playblast_folder"
        label   "Live Playblast"

        parm {
            name    "live_playblast"
            label   "Live"
            type    button
            joinnext
            default { "0" }
            help    "Playblast the shot in the background (TumbleView, GPU), the current frame first, for the player's Live take. Uses the th::playblast in anim_dive, which says the shot, department and camera; one is added on the workfile's shot when there is none."
            parmtag { "script_callback" "from tumblepipe.pipe.houdini import live_playblast; live_playblast.start_from_animate(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "live_playblast_stop"
            label   "Stop"
            type    button
            default { "0" }
            help    "Stop the live playblast rendering in the background."
            parmtag { "script_callback" "from tumblepipe.pipe.houdini import live_playblast; live_playblast.stop_from_animate(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
    }

    groupcollapsible {
        name    "attributes_folder"
        label   "Attributes"

        parm {
            name    "attribs"
            label   "Attributes"
            type    string
            default { "Cd Alpha width pscale uv*" }
            help    "The attributes of anim_dive's geometry that come to the stage, beside the points, bounds, transforms and visibility the node always reads: names and wildcards, separated by spaces, ^name to leave one out (uv* ^uv3). Cd and Alpha become displayColor and displayOpacity, uv becomes st, width and pscale the curves' and points' widths; without width and pscale every curve gets Missing Width. Read once, at the shot's first frame, but for widths, which follow every frame. Add an attribute a shot needs (rest, a mask) here; a rig carries dozens that do not belong in the animation layer, so * is rarely what you want."
        }
        parm {
            name    "normals"
            label   "Normals"
            type    toggle
            default { "1" }
            help    "Bring the geometry's normals (N, on points or vertices) to the stage and animate them. Off: no normals are authored, and the renderer computes them (what a subdivided mesh does anyway). Turn it off for a rig whose N is wrong."
        }
        parm {
            name    "hide_parts"
            label   "Hide Parts"
            type    toggle
            default { "1" }
            help    "When the shapes that make up one prim do not all agree on a frame (a mesh with both arms, one hidden by the rig's usdvisibility), keep the prim visible and leave its hidden faces out on that frame (holeIndices; hidden curves get width 0). Off: the shape holding the prim's first point decides for all of it, as up to 1.114, and no holeIndices is authored."
        }
        parm {
            name    "asset_primvars"
            label   "Keep Asset Primvars"
            type    toggle
            default { "1" }
            help    "Where the incoming stage already has a primvar that fits the prim (the asset's UVs), author none from the dive, so a later fix of the asset is not hidden by the animation layer. Off: the dive's primvars (the first frame's) are authored over the asset's; use it when the UVs are changed in the dive."
        }
        parm {
            name    "missing_width"
            label   "Missing Width"
            type    float
            default { "0.01" }
            help    "The width of curves and points that have no width or pscale attribute."
            range   { 0 1 }
        }
    }

}
