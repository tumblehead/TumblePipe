# Dialog script for th::playblast::1.0 automatically generated

{
    name	th::playblast::1.0
    script	th::playblast::1.0
    label	"th playblast"

    help {
	""
    }

    inputlabel	1	"Input Stage"
    inputlabel	2	"Input 2"
    inputlabel	3	"Input 3"
    inputlabel	4	"Input 4"

    groupsimple {
        name    "selection"
        label   "Selection"

        parm {
            name    "entity_select"
            label   "Entity"
            type    button
            joinnext
            default { "0" }
            parmtag { "button_icon" "hicon:/SVGIcons.index?BUTTONS_tree_full.svg" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.lops.playblast as th_node; th_node.select(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity"
            label   "Entity"
            type    string
            invisible
            joinnext
            default { "from_context" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity_label"
            label   "shot_label"
            type    label
            nolabel
            default { "from_context: none" }
        }
        parm {
            name    "department"
            label   "Department"
            type    string
            joinnext
            default { "from_context" }
            menu {
                [ "from tumblepipe.pipe.houdini.lops import playblast" ]
                [ "from tumblepipe.pipe.houdini import menus" ]
                [ "" ]
                [ "node = playblast.Playblast(hou.pwd())" ]
                [ "items = node.list_department_names()" ]
                [ "return menus.list_to_menu(items)" ]
                language python
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.lops.playblast as th_node; th_node.update_labels(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "department_label"
            label   "department_label"
            type    label
            nolabel
            default { "" }
        }
        parm {
            name    "camera"
            label   "Camera"
            type    string
            default { "" }
            menu {
                [ "from tumblepipe.pipe.houdini.lops import playblast" ]
                [ "from tumblepipe.pipe.houdini import menus" ]
                [ "" ]
                [ "node = playblast.Playblast(hou.pwd())" ]
                [ "items = node.list_camera_names()" ]
                [ "return menus.list_to_menu(items)" ]
                language python
            }
            parmtag { "script_callback_language" "python" }
        }
    }

    groupsimple {
        name    "settings"
        label   "Settings"

        parm {
            name    "renderer"
            label   "Renderer"
            type    string
            default { "viewport" }
            help    "Viewport: TumblePipe's own renderer (hdThPlayblast), the farm playblast's look, rendered with husk. Houdini GL: Houdini's own flipbook, exactly as the viewport draws (hair, curves and volumes too)."
            menu {
                "viewport"  "Viewport (hdThPlayblast)"
                "gl"        "Houdini GL"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "shading"
            label   "Shading"
            type    string
            default { "lit" }
            help    "Lit: the viewport's lights on the scene's colours. Clay: the same lights on grey. Albedo: the colours alone, unlit. Occlusion: white, darkened only by the ambient occlusion."
            hidewhen "{ renderer != viewport }"
            menu {
                "lit"       "Lit"
                "clay"      "Clay"
                "albedo"    "Albedo"
                "occlusion" "Occlusion"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "shadingmode"
            label   "Shading Mode"
            type    ordinal
            default { "smooth" }
            hidewhen "{ renderer != gl }"
            menu {
                "wire"          "Wireframe"
                "wireghost"     "Wireframe Ghost"
                "hidden"        "Hidden Line"
                "ghost"         "Hidden Line Ghost"
                "matcap"        "MatCap Shaded"
                "matcapwire"    "MatCap Wire Shaded"
                "flat"          "Flat Shaded"
                "flatwire"      "Flat Wire Shaded"
                "smooth"        "Smooth Shaded"
                "smoothwire"    "Smooth Wire Shaded"
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "lighting"
            label   "Lighting"
            type    ordinal
            default { "headlight" }
            hidewhen "{ renderer != gl }"
            menu {
                "off"           "Off"
                "headlight"     "Headlight Only"
                "full"          "Full"
                "fullshadows"   "Full with Shadows"
            }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "frame_range"
            label   "Frame Range"
            type    string
            default { "from_context" }
            menu {
                "from_context"  "From Config"
                "from_settings" "From Settings"
            }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "frame_settings"
            label   "First/Last-Frame"
            type    intvector2
            size    2
            default { "1001" "1001" }
            disablewhen "{ frame_range != from_settings }"
            range   { 1! 999999! }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "roll_settings"
            label   "Pre/Post-Roll"
            type    intvector2
            size    2
            default { "0" "0" }
            disablewhen "{ frame_range != from_settings }"
            range   { 0! 999999! }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "res"
            label   "Resolution"
            type    integer
            size    2
            default { [ "__import__('tumblepipe.pipe.houdini.lops.playblast', fromlist=['default_res']).default_res(hou.pwd(), 0)" python ] [ "__import__('tumblepipe.pipe.houdini.lops.playblast', fromlist=['default_res']).default_res(hou.pwd(), 1)" python ] }
            range   { 0 10 }
            parmtag { "autoscope" "0000000000000000" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "motion_blur"
            label   "Motion Blur"
            type    toggle
            default { "0" }
            help    "Blur what moves while the camera's shutter is open (its Shutter Open/Close)."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "depth_of_field"
            label   "Depth of Field"
            type    toggle
            default { "0" }
            help    "Defocus by the camera's lens: its F-Stop and Focus Distance. An F-Stop of 0 is sharp throughout."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "blur_samples"
            label   "Blur Samples"
            type    integer
            default { "16" }
            help    "Images averaged per frame for the blurs: more is smoother and slower."
            disablewhen "{ motion_blur == 0 depth_of_field == 0 }"
            range   { 2! 64 }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "render_layers"
            label   "Render Layers"
            type    toggle
            default { "0" }
            help    "Also write one movie per render layer (the shot's channels): only that layer's prims, on a transparent background, beside the whole picture's movie and with its version. The shot's channel_prims config names each layer's prims (e.g. characters: /CHAR/*); default without a pattern takes every prim the other layers leave. The sequence player stacks the layers in channel order and can hide each one. Viewport renderer only."
            disablewhen "{ renderer != viewport }"
            parmtag { "script_callback_language" "python" }
        }
    }

    groupsimple {
        name    "actions"
        label   "Actions"

        parm {
            name    "playblast"
            label   "Playblast"
            type    button
            joinnext
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.lops.playblast as th_node; th_node.export(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "view_latest"
            label   "View latest"
            type    button
            joinnext
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.lops.playblast as th_node; th_node.view_latest(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "open_location"
            label   "Browse All"
            type    button
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.lops.playblast as th_node; th_node.open_location(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
    }

}
