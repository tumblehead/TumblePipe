# Dialog script for th::import_render::2.0

{
    name	th::import_render::2.0
    script	th::import_render::2.0
    label	"th import render"

    output	rgba	"beauty"
    output	lpe	"lpe"
    output	aov	"aov"
    output	matte	"matte"
    output	cryptomaterials	"cryptomaterials"
    output	cryptoprimitives	"cryptoprimitives"
    output	layers	"layers"
    output	geometry	"geometry"
    output	camera	"camera"
    output	extra	"extra"
    signature	default	Default	{ }	{ RGBA Cable Cable Cable Cable Cable Cable Geometry Metadata Cable }

    help {
	"A shot's finished render, top to bottom: the beauty (with Channel * every channel's beauty laid over each other, the last on top), cables of the light groups and LPE splits (lpe: a light mix's groups, and diffuse/specular key, dome, direct and indirect), the geometry and camera data (aov: albedo, normal, depth as Mono, uv, position), the mattes, ramps and holdouts (matte) and each cryptomatte's rank planes, whole, for a Cryptomatte COP's crypto1 (cryptomaterials, cryptoprimitives), a cable of each channel's beauty named after the channel (layers), the staged geometry (geometry) and the shot's render camera (camera) for a Rasterize Geometry, then every other AOV (extra: transmission, sss, emission, shadow, ...). AOV Outputs gives each pass an output named after it. Under the node: what each channel reads, or that it has no render yet."
    }

    groupsimple {
        name    "selection"
        label   "Render"

        parm {
            name    "entity_select"
            label   "Shot"
            type    button
            invisible
            joinnext
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.select_entity(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity_browse"
            label   "Browse..."
            type    button
            joinnext
            default { "0" }
            help    "Open the entity picker to search for and pick the entity this node addresses."
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.select_entity(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity"
            label   "Shot"
            type    string
            invisible
            joinnext
            default { "from_context" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "entity_label"
            label   "entity_label"
            type    label
            nolabel
            default { "from_context: none" }
        }
        parm {
            name    "channel"
            label   "Channel"
            type    string
            default { "default" }
            help    "The channel to read; All channels (*) reads every channel of the shot in this one node."
            menu {
                [ "from tumblepipe.pipe.houdini.cops import import_render" ]
                [ "" ]
                [ "return import_render.ImportRender(hou.pwd()).channel_menu()" ]
                language python
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "department"
            label   "Department"
            type    string
            default { "best" }
            help    "best: the highest render department below composite with a complete version (denoise, else render), unless the denoise was made from an older render than the newest one."
            menu {
                [ "from tumblepipe.pipe.houdini.cops import import_render" ]
                [ "from tumblepipe.pipe.houdini import menus" ]
                [ "" ]
                [ "node = import_render.ImportRender(hou.pwd())" ]
                [ "return menus.list_to_menu(node.list_department_names())" ]
                language python
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "version"
            label   "Version"
            type    string
            default { "latest" }
            help    "latest: the newest complete version. Pinning a version needs a concrete department. A check render (Farm Submit's Step) is listed as v#### (check, every Nth): latest reads one only when there is no complete version (a complete version wins over a newer check render)."
            menu {
                [ "from tumblepipe.pipe.houdini.cops import import_render" ]
                [ "" ]
                [ "return import_render.ImportRender(hou.pwd()).version_menu()" ]
                language python
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "time_offset_mode"
            label   "Time Offset"
            type    string
            default { "from_multi" }
            help    "Moves the shot's renders to where the shot sits in this scene: frame F reads the render's frame F minus the offset. From Multi: the shot's place on a Multi's shared timeline (no offset anywhere else). The farm always comps the shot's own frames."
            menu {
                "from_multi"    "From Multi"
                "none"          "None"
                "manual"        "Manual"
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "time_offset"
            label   "Offset Frames"
            type    integer
            default { "0" }
            disablewhen "{ time_offset_mode != manual }"
            range   { -1000 1000 }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "missing_frames"
            label   "Missing Frames"
            type    string
            default { "auto" }
            help    "What a frame the render does not have reads as. Automatic: empty (black), as ever, unless the version is a check render (every Nth frame), which holds. Empty: black. Hold Nearest Frame: the nearest rendered frame, the earlier one when two are as near; before the render's first frame its first, after its last its last. The line under it says which is in use."
            menu {
                "auto"      "Automatic"
                "empty"     "Empty (Black)"
                "hold"      "Hold Nearest Frame"
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "missing_frames_label"
            label   " "
            type    label
            default { "" }
        }
        parm {
            name    "applied_offset"
            label   "Applied Offset"
            type    integer
            invisible
            default { "0" }
            help    "The offset the File COPs read (frame F reads the render's F minus it); kept by the node."
        }
        parm {
            name    "version_label"
            label   "Reads"
            type    label
            default { "" }
        }
        parm {
            name    "resolved"
            label   "Resolved"
            type    string
            invisible
            default { "" }
        }
        parm {
            name    "fields"
            label   "Fields"
            type    string
            invisible
            default { "" }
        }
        parm {
            name    "build_key"
            label   "Build Key"
            type    string
            invisible
            default { "" }
        }
        parm {
            name    "held"
            label   "Held"
            type    string
            invisible
            default { "" }
            help    "What the File COPs hold over missing frames, per channel (first, last, step); kept by the node."
        }
        parm {
            name    "pins"
            label   "Pins"
            type    string
            invisible
            default { "" }
            help    "Set by the composite worker: an all-channels import's frozen version per channel."
        }
    }

    groupcollapsible {
        name    "cache_group"
        label   "Cache"

        parm {
            name    "cache"
            label   "Cache"
            type    toggle
            default { "1" }
            help    "Keeps each frame read in memory, so playing it again does not read the network; the cache empties itself when the read changes. Caches the beauty and layers. Memory grows with every frame played, up to Max Frames per read."
        }
        parm {
            name    "cache_aovs"
            label   "Cache AOVs Too"
            type    toggle
            default { "0" }
            disablewhen "{ cache == 0 }"
            help    "Caches lpe, aov and matte as well: every AOV of every frame, far more memory than the beauty alone."
        }
        parm {
            name    "cache_frames"
            label   "Max Frames"
            type    integer
            default { "250" }
            range   { 1! 2000 }
            help    "How many frames each cached read keeps."
        }
        parm {
            name    "clear_cache"
            label   "Clear Cache"
            type    button
            default { "0" }
            help    "Empties the cache: the next play reads every frame from disk again."
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.clear_cache(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
    }

    groupcollapsible {
        name    "scene_group"
        label   "Scene"

        parm {
            name    "scene_department"
            label   "Department"
            type    string
            default { "from_context" }
            help    "The staged shot the geometry and camera outputs read (th::import_scene inside the node); its shot and channel are this node's (default for All channels)."
            menu {
                [ "opmenu -l -a scene/lopnet/import_shot department" ]
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.scene_changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "scene_version"
            label   "Version"
            type    string
            default { "latest" }
            menu {
                [ "opmenu -l -a scene/lopnet/import_shot version" ]
            }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.scene_changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "scene_label"
            label   "Reads"
            type    label
            default { "not imported: press Update" }
            help    "Update imports the scene; a refresh does only while geometry or camera is wired. geometry and camera stay empty until it has imported."
        }
        parm {
            name    "scene_ready"
            label   "Scene Ready"
            type    toggle
            invisible
            default { "0" }
        }
        parm {
            name    "camera_ready"
            label   "Camera Ready"
            type    toggle
            invisible
            default { "0" }
        }
        parm {
            name    "camera_prim"
            label   "Camera"
            type    string
            default { "/cameras/render_camera" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.scene_changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "primpattern"
            label   "Primitives"
            type    string
            default { "/*" }
            help    "The prims the geometry output imports; anything that is not geometry (cameras, lights) adds nothing."
        }
        parm {
            name    "purpose"
            label   "Purpose"
            type    string
            default { "render" }
            menu {
                "render"    "Render"
                "proxy"     "Proxy"
                "guide"     "Guide"
            }
        }
        parm {
            name    "timesample"
            label   "Time Sample"
            type    ordinal
            default { "1" }
            help    "Animated imports the current frame and recooks every frame; Static imports one frame."
            menu {
                "static"    "Static"
                "animated"  "Animated"
            }
        }
        parm {
            name    "staticimportframe"
            label   "Static Frame"
            type    float
            default { "$FSTART" }
            hidewhen "{ timesample == 1 }"
        }
    }

    groupsimple {
        name    "outputs_group"
        label   "Outputs"

        parm {
            name    "unpack_outputs"
            label   "AOV Outputs"
            type    toggle
            default { "0" }
            help    "Keep a Cable Unpack beside the node for each cable (lpe, aov, matte, the cryptomattes, layers), with one output per pass in it, named after the pass, kept in step with it."
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.unpack_changed(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
    }

    groupsimple {
        name    "actions"
        label   "Actions"

        parm {
            name    "execute"
            label   "Update"
            type    button
            joinnext
            default { "0" }
            help    "Resolve the render again and import the scene."
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.execute(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "open_location"
            label   "Open Location"
            type    button
            joinnext
            default { "0" }
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.open_location(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "render"
            label   "Render"
            type    button
            default { "0" }
            help    "Open Farm Submit with this shot's Render ticked and this import's channel checked (all channels for *); a concrete Department is the render's Up to."
            parmtag { "script_callback" "import tumblepipe.pipe.houdini.cops.import_render as th_node; th_node.render(kwargs)" }
        parmtag { "script_callback_language" "python" }
        }
    }

}
