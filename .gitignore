__pycache__/
*.pyc

# Python virtual environments (e.g. tests/.venv) — anywhere in the tree.
.venv/
venv/

# Built resolver binaries — produced by CI per-platform, never committed.
# Anchored at root so it doesn't shadow the tracked Python facade at
# python/tumblepipe/resolver/.
/resolver/

# Built tt_setup wizard binaries — produced per-platform by
# .ci/build_wizard.py ([stage].prepack build-wizard), never committed.
# Anchored at root; re-included for packing via .hpmignore (like /resolver/).
/bin/

# Built VRAM Inspector hook DSOs — produced per-platform by
# .ci/build_vramhook.py ([stage].prepack build-vramhook), never committed.
# Re-included for packing via .hpmignore (like /resolver/).
/dso/

# CI scratch (hpm + mc, archive + sidecar staging)
.tools/
.artifacts/
build-linux-houdini*/
build-macos-houdini*/
build-windows-houdini*/
build-vramhook-*/
build-delegate-*/
build-ffmpeg-*/

# Local Sphinx build output (source in docs/ is mirrored; _build/ is not)
docs/_build/

# Compiled HDA binaries — source-of-truth is the decompiled directory format.
otls/*.hda
otls/backup/
# ...except this one, which has no decompiled source and is tracked as a
# binary on purpose: the TumblePipe Recipes shelf HDA.
!otls/Recipes.hda

# Per-developer MCP server config — embeds personal machine identities.
.mcp.json

# Per-developer Claude Code harness state.
.claude/

# Startup-generated radial menus — tumblepipe.startup (re)writes or removes
# these per session from the live Recipes.hda / asset-browser favorites.
# Gitignoring also keeps them out of hpm archives (no .hpmignore re-include);
# the authored tumblepipe_pipeline.json stays tracked and shipped.
radial_menus/tumblepipe_recipes.json
radial_menus/tumblepipe_asset_favorites.json

# Built playblast render delegate (src/delegate), never committed.
/plugins/
